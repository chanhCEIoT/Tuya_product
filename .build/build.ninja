build lib/libtal_security.a: C_STATIC_LIBRARY_LINKER__tal_security_ src/tal_security/CMakeFiles/tal_security.dir/src/mbedtls/mbedtls_asymmetrical.c.o src/tal_security/CMakeFiles/tal_security.dir/src/mbedtls/mbedtls_hash.c.o src/tal_security/CMakeFiles/tal_security.dir/src/mbedtls/mbedtls_symmetry.c.o src/tal_security/CMakeFiles/tal_security.dir/src/mbedtls/mbedtls_x509.c.o src/tal_security/CMakeFiles/tal_security.dir/src/tal_asymmetrical.c.o src/tal_security/CMakeFiles/tal_security.dir/src/tal_hash.c.o src/tal_security/CMakeFiles/tal_security.dir/src/tal_symmetry.c.o src/tal_security/CMakeFiles/tal_security.dir/src/tal_x509.c.o
  LANGUAGE_COMPILE_FLAGS = -mlongcalls -Wno-frame-address  -ffunction-sections -fdata-sections -Wall -Werror -Wno-error=unused-function -Wno-error=incompatible-pointer-types -Wno-error=unused-variable -Wno-error=unused-but-set-variable -Wno-error=deprecated-declarations -Wextra -Wno-unused-parameter -Wno-sign-compare -Wno-enum-conversion -gdwarf-4 -ggdb -Os -freorder-blocks -fstrict-volatile-bitfields -fno-jump-tables -fno-tree-switch-conversion -std=gnu17 -Wno-old-style-declaration
  OBJECT_DIR = src/tal_security/CMakeFiles/tal_security.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = lib/libtal_security.a
  TARGET_PDB = tal_security.a.dbg


#############################################
# Utility command for edit_cache

build src/tal_security/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/chanhserver/Tuya_product/.build/src/tal_security && /home/chanhserver/TuyaOpen/.venv/lib/python3.12/site-packages/cmake/data/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build src/tal_security/edit_cache: phony src/tal_security/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build src/tal_security/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/chanhserver/Tuya_product/.build/src/tal_security && /home/chanhserver/TuyaOpen/.venv/lib/python3.12/site-packages/cmake/data/bin/cmake --regenerate-during-build -S/home/chanhserver/TuyaOpen -B/home/chanhserver/Tuya_product/.build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build src/tal_security/rebuild_cache: phony src/tal_security/CMakeFiles/rebuild_cache.util

