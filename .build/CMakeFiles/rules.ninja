  command = $PRE_LINK && /home/chanhserver/TuyaOpen/.venv/lib/python3.12/site-packages/cmake/data/bin/cmake -E rm -f $TARGET_FILE && /home/chanhserver/TuyaOpen/platform/ESP32/.espressif/tools/xtensa-esp-elf/esp-14.2.0_20241119/xtensa-esp-elf/bin/xtensa-esp32-elf-ar qc $TARGET_FILE $LINK_FLAGS $in && /home/chanhserver/TuyaOpen/platform/ESP32/.espressif/tools/xtensa-esp-elf/esp-14.2.0_20241119/xtensa-esp-elf/bin/xtensa-esp32-elf-ranlib $TARGET_FILE && $POST_BUILD
  description = Linking C static library $TARGET_FILE
  restat = $RESTAT


#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = /home/chanhserver/TuyaOpen/.venv/lib/python3.12/site-packages/cmake/data/bin/cmake --regenerate-during-build -S/home/chanhserver/TuyaOpen -B/home/chanhserver/Tuya_product/.build
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = /home/chanhserver/TuyaOpen/.venv/bin/ninja $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = /home/chanhserver/TuyaOpen/.venv/bin/ninja -t targets
  description = All primary targets available:

